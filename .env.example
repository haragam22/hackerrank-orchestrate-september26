# Copy to .env and fill in. Never commit .env (it's gitignored).
# Used by code/enrich_images.py (L0a) and code/enrich_messages.py (L0b)
# as the online-LLM fallback when a local Ollama VLM isn't available.

# AgentRouter API key.
AGENTROUTER_API_KEY=
# Base URL from your AgentRouter dashboard/docs (not guessed here — fill it in).
AGENTROUTER_BASE_URL=
